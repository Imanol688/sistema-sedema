APP_ENV=development
APP_URL=http://localhost/sedema-auth/public
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_KEY=cambiar-por-una-clave-aleatoria-de-64-caracteres

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sedema_db
DB_USERNAME=root
DB_PASSWORD=

# ENVÍO REAL DE CREDENCIALES POR GMAIL
# Requiere una contraseña de aplicación de Google (16 caracteres), no la contraseña normal.
MAIL_TRANSPORT=smtp
MAIL_FROM=tu_cuenta@gmail.com
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_USERNAME=tu_cuenta@gmail.com
MAIL_SMTP_PASSWORD=tu_contrasena_de_aplicacion

# Solo para pruebas locales (NO envía correo):
# MAIL_TRANSPORT=log

# Pasarela de pagos (mock para pruebas locales)
PAYMENT_GATEWAY_MODE=mock
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=

PAYMENT_POINT_OF_SALE_ID=
